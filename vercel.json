{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": null,
      "installCommand": "npm install",
      "buildCommand": "npm run build -w @afh/shared && npm run build -w @afh/web",
      "outputDirectory": "apps/web/dist"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": { "service": "web" }
    }
  ]
}
