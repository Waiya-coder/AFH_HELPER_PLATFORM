{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run build -w @afh/shared && npm run build -w @afh/web",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": { "service": "web" }
    }
  ]
}
