{
  "name": "afh-helper-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @afh/api",
    "dev:web": "npm run dev -w @afh/web",
    "start": "bash scripts/start-dev.sh",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @afh/api",
    "db:seed": "npm run db:seed -w @afh/api",
    "db:seed:demo": "npm run db:seed:demo -w @afh/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @afh/api",
    "db:setup": "npm run db:up && sleep 3 && npm run db:migrate && npm run db:seed:demo"
  },
  "engines": {
    "node": ">=20"
  }
}
