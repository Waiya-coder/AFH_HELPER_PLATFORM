# Database
DATABASE_URL="postgresql://afh:afh_dev_password@localhost:5432/afh_helper?schema=public"

# API
API_PORT=3001
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Production: comma-separated browser origins allowed to call the API
# CORS_ORIGINS=https://your-app.example.com

# --- Client documents (production: use R2 or S3; leave unset for local disk) ---
# S3_BUCKET=afh-helper-documents-prod
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_SSE=AES256

# Local dev only when S3_BUCKET is unset:
# UPLOAD_ROOT=./uploads/clients

# Max client document upload size in bytes (default 52428800 = 50 MB)
# MAX_CLIENT_DOCUMENT_BYTES=52428800

# Local only: load Sunrise demo facility when running db:seed (see npm run db:seed:demo)
# SEED_DEMO=true

# Web (Vite) — set to your public API URL when building for production
VITE_API_URL=http://127.0.0.1:3001
